# ------------------------------------------------------------------
# YAZAKI YMK KENITRA — MOTO Visual Management Platform
# Copy to `.env` and fill with real values. NEVER commit `.env`.
# ------------------------------------------------------------------

# --- Database / Backend (Lovable Cloud · PostgreSQL) ---------------
# Exposed to the browser (publishable, safe)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Server-side only (never prefixed with VITE_)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_PROJECT_ID="your-project-ref"
# Managed by the platform — bypasses RLS, privileged operations only
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxx"

# --- Authentication policy ----------------------------------------
# Comma-separated list of email domains allowed to self-register
VITE_ALLOWED_EMAIL_DOMAINS="yazaki.com"

# --- Storage buckets (create in the backend, keep them PRIVATE) ----
# audit-evidence : NG photos + closing evidence (signed URLs, 1h TTL)
# avatars        : user profile pictures (signed URLs, 1h TTL)
VITE_EVIDENCE_BUCKET="audit-evidence"
VITE_AVATAR_BUCKET="avatars"

# --- Email / notifications ----------------------------------------
# Managed sending (Lovable Emails). Requires a verified sender domain.
LOVABLE_API_KEY="managed-by-platform"
EMAIL_FROM="moto-noreply@yourdomain.com"
EMAIL_REPLY_TO="moto-quality@yourdomain.com"